# FastAPI
APP_NAME=Smart Data Agent
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit
STREAMLIT_PORT=8501
API_BASE_URL=http://api:8000

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=smart_data_agent
MYSQL_USER=smart_agent
MYSQL_PASSWORD=smart_agent_password
MYSQL_ROOT_PASSWORD=root_password

# LLM
LLM_PROVIDER=openai-compatible
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# SQL Safety
SQL_DEFAULT_LIMIT=100
